@using Librarian.No.Dictionaries
@model IReadOnlyCollection<Librarian.No.Dictionaries.Definition>
@{
      Layout = "_Layout";
}

@await Html.PartialAsync("_SearchPage", 
      new []
            {
                  new Definition
                  {
                        Entry = DateOnly.FromDateTime(DateTime.Now),
                        Inflections =
                        [
                              new Inflection
                              {
                                    Phrase = @ViewBag.Search,
                                    Tags = []
                              }
                        ],
                        PartOfSpeech = "phrase"
                  }
            }
            .Concat(Model)
)
