@model IReadOnlyList<string>

@{
    Layout = "_Layout";
}

<div class="box" id="export-view">
    <h1 class="title is-4">Export cards to Anki</h1>

    @if (Model.Count > 0)
    {
        <form hx-post="/anki"
              hx-target="#export-view"
              hx-swap="outerHTML"
              id="decks">
            <div class="field">
                <label class="label">Select Anki deck</label>
                @for (var i = 0; i < Model.Count; ++i)
                {
                    var deck = Model[i];

                    <div class="control">
                        <label class="radio">
                            <input type="radio" name="deck" value="@deck" @(i == 0 ? "checked" : "")/>
                            @deck
                        </label>
                    </div>
                }
                <div class="control">
                    <button class="button" type="submit">Export</button>
                </div>
            </div>
        </form>
    }
    else
    {
        <article class="message is-warning">
            <div class="message-body">
                No decks were found. Check if Anki is running on your machine.
            </div>
        </article>
    }
</div>