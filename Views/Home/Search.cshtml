@model IReadOnlyCollection<Librarian.No.Dictionaries.Definition>
@{
    Layout = "_Layout";
}

<div id="search-results">
    @foreach (var definition in Model)
    {
        <div class="definition">
            @foreach (var inflection in definition.Inflections)
            {
                <form hx-post="/cards"
                      hx-target="#cards-container"
                      hx-swap="beforeend"
                >
                    <div style="display: flex">
                        <input
                            name="phrase"
                            type="text"
                            readonly
                            value="@inflection.Phrase"
                        >
                        <input
                            name="part-of-speech"
                            type="text"
                            readonly
                            value="@definition.PartOfSpeech">
                        <input
                            name="tags"
                            type="text"
                            readonly
                            value="@(string.Join(", ", inflection.Tags))"
                        >
                    </div>
                    <div>
                        <input type="submit" class="add-button" value="Add">
                        <audio preload="none" controls>
                            <source src="@($"/no/pronunciations/{Uri.EscapeDataString(inflection.Phrase)}")"
                                    type="audio/mpeg">
                        </audio>
                        <button
                            hx-get="@($"/no/translations/{Uri.EscapeDataString(inflection.Phrase)}")"
                            hx-target="this"
                            hx-swap="outerHTML"
                        >
                            Translate
                        </button>
                    </div>
                </form>
            }
        </div>
    }
</div>
