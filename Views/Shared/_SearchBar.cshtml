@using Librarian.No.Dictionaries

<form 
    action="/search"
    method="get"
>
    <div id="search-bar">
        <input name="phrase" placeholder="Enter a word to search" required="required" value="@ViewBag.Search">
    </div>
    <div>
        @{
            var entries = PartOfSpeechExtensions.SupportedPartOfSpeeches;
            for (var i = 0; i < entries.Count; ++i)
            {
                <input 
                    class="pos"
                    id="@entries[i]" 
                    name="pos" 
                    type="radio" 
                    value="@entries[i]"
                    checked="@(i == 0)"/>
                <label for="@entries[i]">@entries[i]</label> 
            }
        }
    </div>
</form>